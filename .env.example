# CrimsonSync frontend configuration
# Static vanilla builds can expose these via window.CRIMSONSYNC_ENV or a future bundler.

APP_NAME=CrimsonSync
API_BASE_URL=https://api.example.com/v1
AUTH_TOKEN_KEY=crimsonsync_auth_token
UPLOAD_ENDPOINT=/uploads
WEBSOCKET_URL=wss://api.example.com/chat
DEFAULT_THEME=light
